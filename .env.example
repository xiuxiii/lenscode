# ─────────────────────────────────────────────────────────────────────────
#  Setup: copy this file to .env.local, paste your DeepSeek key below,
#  and restart `npm run dev`. That's it.
#
#  .env.local is gitignored. Never commit a real key.
# ─────────────────────────────────────────────────────────────────────────


# ── SERVER ONLY ──────────────────────────────────────────────────────────
# Read by the /api/explain route in server/, never sent to the browser.
# These must NOT have a VITE_ prefix: that prefix is exactly what would
# publish them in the client bundle.

# Required. Your DeepSeek API key (https://platform.deepseek.com/api_keys).
# Without it, the app still opens, but Explain shows "No LLM_API_KEY is configured".
LLM_API_KEY=

# Optional. Any OpenAI-compatible chat-completions API works; the defaults
# are DeepSeek's. Change these to use another provider or a self-hosted
# open-source model (e.g. Ollama: LLM_BASE_URL=http://localhost:11434/v1).
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Optional. Give up on the LLM after this many milliseconds (default 40000).
# LLM_TIMEOUT_MS=40000

# Optional. The most AI requests the server makes per day, explanations and
# follow-up questions together; repeats answered from its cache are free.
# Past it, Explain says so until midnight (server time). Counted per server
# process. Unset or 0 means no limit.
# LLM_DAILY_LIMIT=500


# ── CLIENT (public) ──────────────────────────────────────────────────────
# Defaults to /api/explain on the same site. Only set it to point the
# browser at a backend hosted elsewhere. It is a path, not a secret.
# VITE_EXPLANATION_API_URL=/api/explain
